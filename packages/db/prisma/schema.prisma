// This is your Prisma schema file.
// Learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Supabase Pooler URL (port 6543) — used at runtime via PgBouncer
  url       = env("DATABASE_URL")
  // Supabase Direct URL (port 5432) — used only for migrations
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────────────────────────────────────

enum Role {
  SUPER_ADMIN
  TENANT_ADMIN
  STAFF
  INSTRUCTOR
  STUDENT
}

enum TenantStatus {
  TRIAL
  ACTIVE
  SUSPENDED
}

enum TenantPlan {
  FREE
  BASIC
  PRO
}

enum AdmissionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum DiscountType {
  FLAT
  PERCENTAGE
  SCHOLARSHIP
}

enum InvoiceStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

enum PaymentMethod {
  CASH
  BKASH
  NAGAD
  BANK_TRANSFER
  CARD
  SSLCOMMERZ
  OTHER
}

enum ExpenseCategory {
  SALARY
  RENT
  UTILITIES
  MARKETING
  EQUIPMENT
  OTHER
}

enum PayrollStatus {
  DRAFT
  APPROVED
  PAID
}

enum ExamType {
  QUIZ
  MIDTERM
  FINAL
  CUSTOM
}

enum ExamStatus {
  DRAFT
  PUBLISHED
}

enum SmsEventType {
  ADMISSION_RECEIVED
  ADMISSION_APPROVED
  FEE_INVOICE_CREATED
  FEE_PAYMENT_RECEIVED
  FEE_OVERDUE_REMINDER
  ATTENDANCE_ABSENT
  EXAM_RESULT_PUBLISHED
  PAYROLL_PAID
  CUSTOM_BULK
  TEST_SMS
}

enum SmsStatus {
  QUEUED
  SENT
  FAILED
  SKIPPED
}

// ─────────────────────────────────────────────────────────────────────────────
// TENANT
// The top-level entity. Every institute/coaching center is a Tenant.
// ─────────────────────────────────────────────────────────────────────────────

model Tenant {
  id          String       @id @default(cuid())
  name        String
  slug        String       @unique // subdomain: abc-institute → abc-institute.yourapp.com
  status      TenantStatus @default(TRIAL)
  plan        TenantPlan   @default(FREE)

  // Per-tenant public site customization stored as JSON
  // Shape defined by TenantThemeConfig in @repo/shared
  themeConfig Json         @default("{}")

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  // Relations
  users                 User[]
  sessions              Session[]
  categories            Category[]
  courses               Course[]
  batches               Batch[]
  admissionApplications AdmissionApplication[]
  students              Student[]
  attendanceRecords     AttendanceRecord[]
  feeStructures         FeeStructure[]
  discounts             Discount[]
  feeAssignments        StudentFeeAssignment[]
  feeInvoices           FeeInvoice[]
  payments              Payment[]
  expenses              Expense[]
  smsReminderLogs       SmsReminderLog[]
  staffProfiles         StaffProfile[]
  payrolls              Payroll[]
  exams                 Exam[]
  examResults           ExamResult[]
  gradeScales           GradeScale[]
  smsSettings           SmsSettings?
  smsTemplates          SmsTemplate[]
  smsLogs               SmsLog[]
  notifications         Notification[]

  @@index([slug])
  @@map("tenants")
}

// ─────────────────────────────────────────────────────────────────────────────
// USER
// Platform-level users. SUPER_ADMIN has tenantId = null.
// All other roles are scoped to a tenant.
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  email        String
  passwordHash String
  firstName    String
  lastName     String
  phone        String?
  role         Role     @default(STAFF)
  isActive     Boolean  @default(true)

  // null only for SUPER_ADMIN
  tenantId     String?
  tenant       Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  sessions          Session[]
  instructorBatches Batch[]
  studentProfile    Student?
  markedAttendances AttendanceRecord[] @relation("MarkedAttendance")
  approvedDiscounts Discount[]         @relation("ApprovedDiscounts")
  receivedPayments   Payment[]          @relation("ReceivedPayments")
  createdExpenses    Expense[]          @relation("CreatedExpenses")
  staffProfile       StaffProfile?
  enteredExamResults ExamResult[]       @relation("EnteredExamResults")
  notifications      Notification[]

  // Unique email per tenant (SUPER_ADMIN: email unique globally)
  @@unique([email, tenantId])
  @@index([tenantId])
  @@index([email])
  @@map("users")
}

// ─────────────────────────────────────────────────────────────────────────────
// SESSION
// Stores refresh tokens. One user can have multiple active sessions
// (multiple devices). Invalidated on logout.
// ─────────────────────────────────────────────────────────────────────────────

model Session {
  id           String   @id @default(cuid())
  refreshToken String   @unique
  expiresAt    DateTime
  userAgent    String?
  ipAddress    String?
  isRevoked    Boolean  @default(false)

  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Denormalized for quick tenant-level session queries
  tenantId     String?
  tenant       Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId])
  @@index([tenantId])
  @@index([refreshToken])
  @@map("sessions")
}

// ─────────────────────────────────────────────────────────────────────────────
// CATEGORY
// Course categories.
// ─────────────────────────────────────────────────────────────────────────────

model Category {
  id          String   @id @default(cuid())
  name        String
  description String?

  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  courses     Course[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId])
  @@map("categories")
}

// ─────────────────────────────────────────────────────────────────────────────
// COURSE
// Defines the templates/catalog items.
// ─────────────────────────────────────────────────────────────────────────────

model Course {
  id          String   @id @default(cuid())
  name        String
  description String?
  duration    String?  // e.g., "3 months"
  fees        Float

  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  batches               Batch[]
  admissionApplications AdmissionApplication[]
  feeStructures         FeeStructure[]
  exams                 Exam[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId])
  @@index([categoryId])
  @@map("courses")
}

// ─────────────────────────────────────────────────────────────────────────────
// BATCH
// A specific cohort for a course.
// ─────────────────────────────────────────────────────────────────────────────

model Batch {
  id          String    @id @default(cuid())
  name        String
  startDate   DateTime?
  endDate     DateTime?
  schedule    String?
  capacity    Int?

  instructorId String?
  instructor   User?    @relation(fields: [instructorId], references: [id], onDelete: SetNull)

  courseId    String
  course      Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)

  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  students          Student[]
  attendanceRecords AttendanceRecord[]
  exams             Exam[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([tenantId])
  @@index([courseId])
  @@index([instructorId])
  @@map("batches")
}

// ─────────────────────────────────────────────────────────────────────────────
// ADMISSION APPLICATION
// Public admission form submissions waiting for admin review.
// ─────────────────────────────────────────────────────────────────────────────

model AdmissionApplication {
  id            String          @id @default(cuid())
  name          String
  phone         String
  email         String?
  address       String?
  guardianName  String?
  guardianPhone String?
  message       String?
  status        AdmissionStatus @default(PENDING)

  courseId      String
  course        Course          @relation(fields: [courseId], references: [id], onDelete: Cascade)

  tenantId      String
  tenant        Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([tenantId])
  @@index([courseId])
  @@index([status])
  @@map("admission_applications")
}

// ─────────────────────────────────────────────────────────────────────────────
// STUDENT
// Enrolled student profile linked 1-to-1 with a User (role = STUDENT).
// ─────────────────────────────────────────────────────────────────────────────

model Student {
  id             String   @id @default(cuid())
  guardianName   String?
  guardianPhone  String?
  enrollmentDate DateTime @default(now())
  address        String?

  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  batchId        String?
  batch          Batch?   @relation(fields: [batchId], references: [id], onDelete: SetNull)

  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  attendanceRecords AttendanceRecord[]
  discounts         Discount[]
  feeAssignments    StudentFeeAssignment[]
  feeInvoices       FeeInvoice[]
  examResults       ExamResult[]

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([tenantId])
  @@index([batchId])
  @@map("students")
}

// ─────────────────────────────────────────────────────────────────────────────
// ATTENDANCE RECORD
// Per-student, per-batch attendance record for a given class date.
// ─────────────────────────────────────────────────────────────────────────────

model AttendanceRecord {
  id         String           @id @default(cuid())
  date       DateTime
  status     AttendanceStatus @default(PRESENT)
  remarks    String?

  studentId  String
  student    Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)

  batchId    String
  batch      Batch            @relation(fields: [batchId], references: [id], onDelete: Cascade)

  markedById String?
  markedBy   User?            @relation("MarkedAttendance", fields: [markedById], references: [id], onDelete: SetNull)

  tenantId   String
  tenant     Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@unique([studentId, batchId, date])
  @@index([tenantId])
  @@index([batchId, date])
  @@index([studentId])
  @@map("attendance_records")
}

// ─────────────────────────────────────────────────────────────────────────────
// PHASE 3: FEES & ACCOUNTING
// ─────────────────────────────────────────────────────────────────────────────

model FeeStructure {
  id               String   @id @default(cuid())
  name             String
  totalAmount      Decimal  @db.Decimal(12, 2)
  installmentCount Int      @default(1)
  // Array of { sequence: number, percent?: number, amount?: number, dueOffsetDays: number }
  installmentPlan  Json     @default("[]")
  isActive         Boolean  @default(true)

  courseId         String
  course           Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  tenantId         String
  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  assignments      StudentFeeAssignment[]

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([tenantId, courseId, name])
  @@index([tenantId])
  @@index([courseId])
  @@map("fee_structures")
}

model Discount {
  id           String       @id @default(cuid())
  title        String
  type         DiscountType
  value        Decimal      @db.Decimal(12, 2)
  reason       String?
  isActive     Boolean      @default(true)

  studentId    String?
  student      Student?     @relation(fields: [studentId], references: [id], onDelete: SetNull)

  approvedById String?
  approvedBy   User?        @relation("ApprovedDiscounts", fields: [approvedById], references: [id], onDelete: SetNull)

  tenantId     String
  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  assignments  StudentFeeAssignment[]

  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([tenantId])
  @@index([studentId])
  @@map("discounts")
}

model StudentFeeAssignment {
  id             String       @id @default(cuid())
  overrideTotal  Decimal?     @db.Decimal(12, 2)
  discountAmount Decimal      @default(0) @db.Decimal(12, 2)
  netPayable     Decimal      @db.Decimal(12, 2)
  note           String?

  studentId      String
  student        Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)

  structureId    String
  structure      FeeStructure @relation(fields: [structureId], references: [id], onDelete: Restrict)

  discountId     String?
  discount       Discount?    @relation(fields: [discountId], references: [id], onDelete: SetNull)

  tenantId       String
  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  invoices       FeeInvoice[]

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([tenantId])
  @@index([studentId])
  @@index([structureId])
  @@map("student_fee_assignments")
}

model FeeInvoice {
  id            String                @id @default(cuid())
  invoiceNo     String
  title         String?
  installmentNo Int                   @default(1)
  amount        Decimal               @db.Decimal(12, 2)
  discount      Decimal               @default(0) @db.Decimal(12, 2)
  paidAmount    Decimal               @default(0) @db.Decimal(12, 2)
  dueDate       DateTime
  status        InvoiceStatus         @default(UNPAID)

  studentId     String
  student       Student               @relation(fields: [studentId], references: [id], onDelete: Cascade)

  assignmentId  String?
  assignment    StudentFeeAssignment? @relation(fields: [assignmentId], references: [id], onDelete: SetNull)

  tenantId      String
  tenant        Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  payments      Payment[]
  smsReminders  SmsReminderLog[]

  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  @@unique([tenantId, invoiceNo])
  @@index([tenantId])
  @@index([studentId])
  @@index([status])
  @@index([dueDate])
  @@map("fee_invoices")
}

model Payment {
  id           String        @id @default(cuid())
  receiptNo    String
  amount       Decimal       @db.Decimal(12, 2)
  method       PaymentMethod @default(CASH)
  reference    String?
  tranId       String?
  status       String        @default("COMPLETED") // COMPLETED | VOIDED | PENDING
  note         String?
  paidAt       DateTime      @default(now())

  invoiceId    String
  invoice      FeeInvoice    @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  receivedById String?
  receivedBy   User?         @relation("ReceivedPayments", fields: [receivedById], references: [id], onDelete: SetNull)

  tenantId     String
  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@unique([tenantId, receiptNo])
  @@index([tenantId])
  @@index([invoiceId])
  @@index([tranId])
  @@map("payments")
}

model Expense {
  id          String          @id @default(cuid())
  title       String
  category    ExpenseCategory @default(OTHER)
  amount      Decimal         @db.Decimal(12, 2)
  date        DateTime        @default(now())
  note        String?

  createdById String?
  createdBy   User?           @relation("CreatedExpenses", fields: [createdById], references: [id], onDelete: SetNull)

  tenantId    String
  tenant      Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  payroll     Payroll?

  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([tenantId])
  @@index([category])
  @@index([date])
  @@map("expenses")
}

model SmsReminderLog {
  id        String     @id @default(cuid())
  phone     String
  message   String
  status    String     @default("SENT") // SENT | STUBBED | FAILED
  provider  String     @default("GREENWEB_BD")
  sentAt    DateTime   @default(now())

  invoiceId String
  invoice   FeeInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  tenantId  String
  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([invoiceId])
  @@map("sms_reminder_logs")
}

// ─────────────────────────────────────────────────────────────────────────────
// PHASE 4: STAFF & PAYROLL
// ─────────────────────────────────────────────────────────────────────────────

model StaffProfile {
  id           String   @id @default(cuid())
  designation  String
  department   String?
  joinDate     DateTime @default(now())
  baseSalary   Decimal  @db.Decimal(12, 2)
  bankInfo     String?
  mobileWallet String?
  isActive     Boolean  @default(true)

  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  payrolls     Payroll[]

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([tenantId])
  @@map("staff_profiles")
}

model Payroll {
  id         String         @id @default(cuid())
  month      Int
  year       Int
  baseAmount Decimal        @db.Decimal(12, 2)
  allowances Decimal        @default(0) @db.Decimal(12, 2)
  deductions Decimal        @default(0) @db.Decimal(12, 2)
  bonus      Decimal        @default(0) @db.Decimal(12, 2)
  netAmount  Decimal        @db.Decimal(12, 2)
  status     PayrollStatus  @default(DRAFT)
  paidAt     DateTime?
  method     PaymentMethod?
  note       String?

  staffId    String
  staff      StaffProfile   @relation(fields: [staffId], references: [id], onDelete: Cascade)

  expenseId  String?        @unique
  expense    Expense?       @relation(fields: [expenseId], references: [id], onDelete: SetNull)

  tenantId   String
  tenant     Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@unique([staffId, month, year])
  @@index([tenantId])
  @@index([month, year])
  @@map("payrolls")
}

// ─────────────────────────────────────────────────────────────────────────────
// PHASE 4: EXAMS, RESULTS & REPORT CARDS
// ─────────────────────────────────────────────────────────────────────────────

model Exam {
  id         String     @id @default(cuid())
  name       String
  type       ExamType   @default(CUSTOM)
  term       String?
  date       DateTime
  totalMarks Decimal    @db.Decimal(8, 2)
  passMarks  Decimal    @db.Decimal(8, 2)
  status     ExamStatus @default(DRAFT)

  batchId    String
  batch      Batch      @relation(fields: [batchId], references: [id], onDelete: Cascade)

  courseId   String
  course     Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)

  tenantId   String
  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  results    ExamResult[]

  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@index([tenantId])
  @@index([batchId])
  @@index([courseId])
  @@map("exams")
}

model ExamResult {
  id            String   @id @default(cuid())
  marksObtained Decimal  @default(0) @db.Decimal(8, 2)
  grade         String?
  gpaPoint      Decimal? @db.Decimal(4, 2)
  remarks       String?
  isAbsent      Boolean  @default(false)

  examId        String
  exam          Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)

  studentId     String
  student       Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  enteredById   String?
  enteredBy     User?    @relation("EnteredExamResults", fields: [enteredById], references: [id], onDelete: SetNull)

  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([examId, studentId])
  @@index([tenantId])
  @@index([examId])
  @@index([studentId])
  @@map("exam_results")
}

model GradeScale {
  id         String   @id @default(cuid())
  grade      String
  minPercent Decimal  @db.Decimal(5, 2)
  maxPercent Decimal  @db.Decimal(5, 2)
  gpaPoint   Decimal  @db.Decimal(4, 2)

  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([tenantId, grade])
  @@index([tenantId])
  @@map("grade_scales")
}

// ─────────────────────────────────────────────────────────────────────────────
// PHASE 5: SMS GATEWAY (BULKSMSBD) & NOTIFICATIONS
// ─────────────────────────────────────────────────────────────────────────────

model SmsSettings {
  id              String    @id @default(cuid())
  provider        String    @default("BULKSMSBD")
  apiKeyEncrypted String?
  apiKeyHint      String?
  senderId        String?
  adminPhone      String?
  isEnabled       Boolean   @default(false)
  enabledEvents   Json      @default("{}")
  lastBalance     String?
  lastBalanceAt   DateTime?

  tenantId        String    @unique
  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@map("sms_settings")
}

model SmsTemplate {
  id        String       @id @default(cuid())
  eventType SmsEventType
  body      String
  isActive  Boolean      @default(true)

  tenantId  String
  tenant    Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@unique([tenantId, eventType])
  @@index([tenantId])
  @@map("sms_templates")
}

model SmsLog {
  id               String       @id @default(cuid())
  phone            String
  message          String
  eventType        SmsEventType @default(CUSTOM_BULK)
  status           SmsStatus    @default(QUEUED)
  provider         String       @default("BULKSMSBD")
  providerCode     String?
  providerResponse String?
  segments         Int          @default(1)
  relatedType      String?
  relatedId        String?
  sentAt           DateTime     @default(now())

  tenantId         String
  tenant           Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt        DateTime     @default(now())

  @@index([tenantId])
  @@index([status])
  @@index([eventType])
  @@index([sentAt])
  @@map("sms_logs")
}

model Notification {
  id        String   @id @default(cuid())
  title     String
  body      String
  type      String   @default("INFO")
  link      String?
  isRead    Boolean  @default(false)

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([userId, isRead])
  @@map("notifications")
}
