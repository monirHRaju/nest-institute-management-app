// This is your Prisma schema file.
// Learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Supabase Pooler URL (port 6543) — used at runtime via PgBouncer
  url       = env("DATABASE_URL")
  // Supabase Direct URL (port 5432) — used only for migrations
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────────────────────────────────────

enum Role {
  SUPER_ADMIN
  TENANT_ADMIN
  STAFF
  INSTRUCTOR
  STUDENT
}

enum TenantStatus {
  TRIAL
  ACTIVE
  SUSPENDED
}

enum TenantPlan {
  FREE
  BASIC
  PRO
}

// ─────────────────────────────────────────────────────────────────────────────
// TENANT
// The top-level entity. Every institute/coaching center is a Tenant.
// ─────────────────────────────────────────────────────────────────────────────

model Tenant {
  id          String       @id @default(cuid())
  name        String
  slug        String       @unique // subdomain: abc-institute → abc-institute.yourapp.com
  status      TenantStatus @default(TRIAL)
  plan        TenantPlan   @default(FREE)

  // Per-tenant public site customization stored as JSON
  // Shape defined by TenantThemeConfig in @repo/shared
  themeConfig Json         @default("{}")

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  // Relations
  users       User[]
  sessions    Session[]
  categories  Category[]
  courses     Course[]
  batches     Batch[]

  @@index([slug])
  @@map("tenants")
}

// ─────────────────────────────────────────────────────────────────────────────
// USER
// Platform-level users. SUPER_ADMIN has tenantId = null.
// All other roles are scoped to a tenant.
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  email        String
  passwordHash String
  firstName    String
  lastName     String
  phone        String?
  role         Role     @default(STAFF)
  isActive     Boolean  @default(true)

  // null only for SUPER_ADMIN
  tenantId     String?
  tenant       Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  sessions     Session[]
  instructorBatches Batch[]

  // Unique email per tenant (SUPER_ADMIN: email unique globally)
  @@unique([email, tenantId])
  @@index([tenantId])
  @@index([email])
  @@map("users")
}

// ─────────────────────────────────────────────────────────────────────────────
// SESSION
// Stores refresh tokens. One user can have multiple active sessions
// (multiple devices). Invalidated on logout.
// ─────────────────────────────────────────────────────────────────────────────

model Session {
  id           String   @id @default(cuid())
  refreshToken String   @unique
  expiresAt    DateTime
  userAgent    String?
  ipAddress    String?
  isRevoked    Boolean  @default(false)

  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Denormalized for quick tenant-level session queries
  tenantId     String?
  tenant       Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId])
  @@index([tenantId])
  @@index([refreshToken])
  @@map("sessions")
}

// ─────────────────────────────────────────────────────────────────────────────
// CATEGORY
// Course categories.
// ─────────────────────────────────────────────────────────────────────────────

model Category {
  id          String   @id @default(cuid())
  name        String
  description String?

  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  courses     Course[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId])
  @@map("categories")
}

// ─────────────────────────────────────────────────────────────────────────────
// COURSE
// Defines the templates/catalog items.
// ─────────────────────────────────────────────────────────────────────────────

model Course {
  id          String   @id @default(cuid())
  name        String
  description String?
  duration    String?  // e.g., "3 months"
  fees        Float

  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  batches     Batch[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId])
  @@index([categoryId])
  @@map("courses")
}

// ─────────────────────────────────────────────────────────────────────────────
// BATCH
// A specific cohort for a course.
// ─────────────────────────────────────────────────────────────────────────────

model Batch {
  id          String    @id @default(cuid())
  name        String
  startDate   DateTime?
  endDate     DateTime?
  schedule    String?
  capacity    Int?

  instructorId String?
  instructor   User?    @relation(fields: [instructorId], references: [id], onDelete: SetNull)

  courseId    String
  course      Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)

  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([tenantId])
  @@index([courseId])
  @@index([instructorId])
  @@map("batches")
}
