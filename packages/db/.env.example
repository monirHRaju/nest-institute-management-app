# packages/db — Environment Variables
# Copy to .env and fill in your Supabase credentials.
# NEVER commit .env to git.

# ── Supabase Pooler URL (Transaction mode, port 6543) ──────────────────────
# Used by Prisma Client at runtime via PgBouncer connection pooling.
# Found in: Supabase Dashboard → Project → Settings → Database → Connection string → Transaction
DATABASE_URL="postgresql://postgres.[project-ref]:[db-password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"

# ── Supabase Direct URL (port 5432) ────────────────────────────────────────
# Used only by `prisma migrate dev` / `prisma migrate deploy`.
# Found in: Supabase Dashboard → Project → Settings → Database → Connection string → Direct
DIRECT_URL="postgresql://postgres.[project-ref]:[db-password]@aws-0-[region].supabase.com:5432/postgres"
